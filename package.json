{
  "name": "warframe-build-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Warframe guide agent pack with Warframe Status and Warframe.market clients",
  "type": "module",
  "bin": {
    "wf-status": "./dist/cli.js",
    "wf-market": "./dist/market/cli.js",
    "wf-patches": "./dist/patches/cli.js",
    "wf-knowledge": "./dist/knowledge/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "wf": "tsx src/cli.ts",
    "market": "tsx src/market/cli.ts",
    "patches": "tsx src/patches/cli.ts",
    "knowledge": "tsx src/knowledge/cli.ts",
    "knowledge:export-overframe": "tsx scripts/export-overframe-builds.ts",
    "hermes:pack": "./scripts/pack-hermes-profile.sh",
    "hermes:pack:with-knowledge": "./scripts/pack-hermes-profile.sh --with-knowledge",
    "knowledge:pack": "./scripts/pack-knowledge-sidecar.sh",
    "start": "tsx src/cli.ts",
    "test": "tsx --test src/*.test.ts src/market/*.test.ts src/patches/*.test.ts src/knowledge/*.test.ts src/knowledge/dps/*.test.ts",
    "typecheck": "tsc --noEmit",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:start": "npm --prefix web run start",
    "web:test": "npm --prefix web run test",
    "cleanup:verify": "./scripts/cleanup-verify.sh",
    "cleanup:verify:all": "./scripts/cleanup-verify-all.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "playwright": "^1.51.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
