{
  "name": "warframe-build-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Warframe guide agent pack plus a thin Warframe Status world-state client",
  "type": "module",
  "bin": {
    "wf-status": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "wf": "tsx src/cli.ts",
    "start": "tsx src/cli.ts",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
