# --- Chat backend ---
# Option A: OpenAI (or any OpenAI-compatible provider)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Vision model used when a screenshot is attached (defaults to OPENAI_MODEL)
# OPENAI_VISION_MODEL=gpt-4o

# Option B: Local OpenAI-compatible server (Ollama / LM Studio / vLLM)
# Example — Qwen via Ollama (tools still read data/knowledge/):
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen3.6
# OPENAI_VISION_MODEL=llava
# Same pattern works for Hermes — see ../hermes/LOCAL_LLM.md

# Option C: Fully local deterministic chatbot (knowledge pack + OCR, no LLM)
# CHAT_MODE=local

# Optional shared password for on-the-go personal use
# CHAT_PASSWORD=changeme

# Optional URLs to daily scrape JSON committed by GitHub Actions (raw GitHub links work)
# MARKET_CHANGES_URL=https://raw.githubusercontent.com/<you>/Warframe-Build-Agent/main/data/market/latest-changes.json
# PATCH_CHANGES_URL=https://raw.githubusercontent.com/<you>/Warframe-Build-Agent/main/data/patches/latest-changes.json
# PATCH_SNAPSHOT_URL=https://raw.githubusercontent.com/<you>/Warframe-Build-Agent/main/data/patches/latest-snapshot.json
