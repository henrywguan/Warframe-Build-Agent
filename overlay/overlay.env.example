# Copy to ~/.config/warframe-build-agent/overlay.env (or export these vars)

# Recommended: route overlay chat through the web API so Ordis gets the full
# offline knowledge pack tools (lookup, loadout compare, modded DPS, live Status/Market/Patches).
# Start web with CHAT_MODE=local or OPENAI_BASE_URL pointing at Qwen/Ollama.
CHAT_API_URL=http://127.0.0.1:3000/api/chat
# CHAT_PASSWORD=

# Alternative: direct OpenAI-compatible chat (NO pack tools — model may invent facts).
# Prefer CHAT_API_URL above for offline-accurate answers.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Local LLM example (still no pack tools unless using CHAT_API_URL):
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen3.6
