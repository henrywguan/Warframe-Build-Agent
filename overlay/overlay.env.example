# Copy to ~/.config/warframe-build-agent/overlay.env (or export these vars)

# Direct OpenAI-compatible chat (recommended for in-game overlay)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: point at a running web chat backend instead
# CHAT_API_URL=http://127.0.0.1:3000/api/chat
# CHAT_PASSWORD=